generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  OWNER
  ADMIN
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum InquiryStatus {
  NEW
  VIEWED
  RESPONDED
  CLOSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  phone      String?
  role       Role     @default(CUSTOMER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  businesses Business[]
  reviews    Review[]
}

model Category {
  id         String   @id @default(cuid())
  name       String   @unique
  slug       String   @unique
  icon       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  businesses Business[]
}

model Business {
  id           String         @id @default(cuid())
  ownerId      String
  categoryId   String
  businessName String
  slug         String         @unique
  description  String
  phone        String
  email        String?
  address      String
  city         String
  state        String
  pincode      String
  logoUrl      String?
  bannerUrl    String?
  status       BusinessStatus @default(PENDING)
  isFeatured   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  owner     User           @relation(fields: [ownerId], references: [id])
  category  Category       @relation(fields: [categoryId], references: [id])
  hours     BusinessHour[]
  services  Service[]
  products  Product[]
  inquiries Inquiry[]
  bookings  Booking[]
  reviews   Review[]
}

model BusinessHour {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int
  openTime   String?
  closeTime  String?
  isClosed   Boolean  @default(false)

  business Business @relation(fields: [businessId], references: [id])
}

model Service {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal?  @db.Decimal(10, 2)
  duration    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id])
  bookings Booking[]
}

model Product {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal?  @db.Decimal(10, 2)
  imageUrl    String?
  stock       Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])
}

model Inquiry {
  id            String        @id @default(cuid())
  businessId    String
  customerName  String
  customerEmail String
  customerPhone String?
  message       String
  status        InquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id])
}

model Booking {
  id            String        @id @default(cuid())
  businessId    String
  serviceId     String
  customerName  String
  customerEmail String
  customerPhone String?
  bookingDate   DateTime
  bookingTime   String
  notes         String?
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}